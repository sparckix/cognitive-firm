# cognitive-firm — environment variable reference
#
# Copy this file to `.env` (gitignored) and fill in the values you need.
# All variables are optional unless marked REQUIRED. Defaults shown are what
# the kernel falls back to when the variable is unset.
#
# This file documents every env var the kernel + Orbit dashboard read.
# If you add a new env var to the codebase, add it here.

# ─────────────────────────────────────────────────────────────────────
# 1. LLM API keys
# ─────────────────────────────────────────────────────────────────────
# Set at least one provider key only when you want the kernel itself to make
# provider API calls. Agent-side work through Claude/Codex subscription CLIs can
# use local subscription auth instead; see §2.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# OpenAI-compatible local/OSS endpoint. Examples include local servers that
# expose `/v1/chat/completions` plus hosted OpenAI-compatible providers.
# Set OPENAI_COMPATIBLE_MODEL or pass `--model-id openai-compatible:<model>`.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# ─────────────────────────────────────────────────────────────────────
# 2. Agent-CLI runtime
# ─────────────────────────────────────────────────────────────────────
# The daemon spawns a subprocess agent (Claude Code, codex, etc.) for
# role-bearing work. These knobs select which CLI and how it authenticates.
#
# Agent subprocesses prefer subscription/local auth by default. For known
# subscription CLIs, cognitive-firm removes the provider API key that would
# otherwise override token/OAuth state: ANTHROPIC_API_KEY for Claude and
# OPENAI_API_KEY/OPENAI_BASE_URL/OPENAI_ORG_ID for Codex. Token-shaped local
# auth such as ANTHROPIC_AUTH_TOKEN and HOME are preserved.
# Set COGNITIVE_FIRM_AGENT_ALLOW_API_KEY_AUTH=1 only when you intentionally want
# a spawned role-bearing CLI to use metered API-key auth.
COGNITIVE_FIRM_AGENT_ALLOW_API_KEY_AUTH=
COGNITIVE_FIRM_AGENT_SCRUB_ALL_MODEL_API_KEYS=

# Provider-neutral subscription runtime selector. Common values: "claude",
# "codex". Demo Make targets can use this without hardcoding CLI flags.
COGNITIVE_FIRM_SUBSCRIPTION_RUNTIME=

# Which subprocess to spawn. Common values: "claude", "codex", or an absolute
# path to a wrapper. When unset, the daemon falls back to the principal's
# preferred_agent_cli in org/preferences/principal.yaml.
COGNITIVE_FIRM_AGENT_CLI=

# Adapter that wraps the CLI's noninteractive interface.
# Supported: "auto" (infer from CLI name), "claude_print", "codex_exec".
# Default: auto
COGNITIVE_FIRM_AGENT_ADAPTER=auto

# Make-target aliases for live demos. These can mirror the values above:
# `make self-evolving-daemon-live-governed-demo` reads AGENT_RUNTIME,
# AGENT_CLI, and AGENT_ADAPTER directly, while scripts read the
# COGNITIVE_FIRM_* names.
AGENT_RUNTIME=
AGENT_CLI=
AGENT_ADAPTER=auto

# Optional live reviewer workers for the self-evolving org demo. When set,
# evaluator, risk_guardian, and learning_steward review offices run through the
# same subscription/local invocation policy and their outputs become A2A
# evidence + decision positions. Leave unset to use protocol-only reviewers.
AGENT_REVIEWER_RUNTIME=
AGENT_REVIEWER_ADAPTER=auto
SELF_EVOLVING_REVIEWER_TIMEOUT_SECONDS=

# Member identity recorded in session/audit rows when an agent acts.
# Default: claude
COGNITIVE_FIRM_MEMBER_ID=

# Claude Code permission mode when invoked noninteractively.
# Common values: "acceptEdits" (default), "ask", "denyEdits".
COGNITIVE_FIRM_CLAUDE_PERMISSION_MODE=acceptEdits

# Optional Claude Code invocation controls for daemon/live-demo subprocesses.
# Use these when the role runtime needs explicit tool permissions or an
# additional readable directory. Values are passed to Claude Code as CLI flags.
COGNITIVE_FIRM_CLAUDE_ALLOWED_TOOLS=
COGNITIVE_FIRM_CLAUDE_DISALLOWED_TOOLS=
COGNITIVE_FIRM_CLAUDE_ADD_DIRS=
COGNITIVE_FIRM_CLAUDE_EXTRA_ARGS=

# Optional Codex invocation controls for daemon/live-demo subprocesses.
# The default sandbox is workspace-write. Set the bypass flag only when the
# surrounding operator environment is already trusted and separately bounded.
COGNITIVE_FIRM_CODEX_SANDBOX=workspace-write
COGNITIVE_FIRM_CODEX_PROFILE=
COGNITIVE_FIRM_CODEX_MODEL=
COGNITIVE_FIRM_CODEX_EXTRA_ARGS=
COGNITIVE_FIRM_CODEX_BYPASS_SANDBOX=

# Prompt transport for daemon/live-demo subprocesses. Default "auto" uses the
# transport each CLI supports: Claude print mode receives an argv prompt; Codex
# exec receives stdin via "-". Receipts redact argv prompt text.
COGNITIVE_FIRM_AGENT_PROMPT_TRANSPORT=auto

# Demo planner controls. `compact` is useful for live smoke tests because the
# planner only needs to propose one conservative bounded change.
SELF_EVOLVING_PLANNER_PROMPT_MODE=full
SELF_EVOLVING_PLANNER_TIMEOUT_SECONDS=600

# Any non-empty value disables the kernel's automatic model-fallback chain
# (e.g. if claude-opus is rate-limited, the kernel normally falls through
# to claude-sonnet). Set this for strict-determinism debugging only.
COGNITIVE_FIRM_DISABLE_MODEL_FALLBACK=

# Override which provider the LLMRuntime dispatches to for substrate calls.
# Common values: "anthropic", "openai", "google", or empty (use default
# routing per principal preferences).
LLM_DISPATCH_PREF=

# ─────────────────────────────────────────────────────────────────────
# 3. Telegram (optional — mobile pager + STOP authority)
# ─────────────────────────────────────────────────────────────────────
# Without these, the daemon still runs but the principal has no mobile
# notification channel. To enable, see scripts/telegram_setup.py.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─────────────────────────────────────────────────────────────────────
# 4. Orbit dashboard (optional — desktop UI)
# ─────────────────────────────────────────────────────────────────────
# Orbit is the desktop TLDraw-based dashboard. These configure the local
# backend it talks to. Set these only if you are running Orbit.

# Backend bind host. Default: 127.0.0.1
ORBIT_BACKEND_HOST=127.0.0.1

# Backend port. Default: 3001
ORBIT_BACKEND_PORT=3001

# Comma-separated list of CORS origins permitted by the backend.
# Default: http://localhost:5173 (the Vite dev server)
ORBIT_CORS_ORIGIN=

# Bearer token required by the Orbit backend for state-mutating endpoints.
# Generate with `openssl rand -hex 32`. If unset, the backend rejects
# write requests — set this before running Orbit.
ORBIT_API_TOKEN=

# Orbit app-surface write policy. Use projection_only for read-only dashboards.
# Use kernel_intents when Orbit should submit typed human intents such as gate
# resolution, controls, chat messages, and human-work updates.
ORBIT_SURFACE_MODE=projection_only

# Stable surface id recorded in health/policy responses.
ORBIT_SURFACE_NAME=orbit

# Kernel service URL used by Orbit and the Telegram push channel for mutations.
COGNITIVE_FIRM_KERNEL_SERVICE_URL=http://127.0.0.1:8765

# Kernel service bearer token for local service deployments. Use a secrets
# manager or systemd EnvironmentFile outside local development.
COGNITIVE_FIRM_KERNEL_TOKEN=

# Actor defaults used by --require-token static bearer mode.
COGNITIVE_FIRM_KERNEL_ACTOR_ID=
COGNITIVE_FIRM_KERNEL_ACTOR_KIND=

# Optional role and tenant scopes used by --require-token
# --enforce-subject-scope in local bearer-token mode.
COGNITIVE_FIRM_KERNEL_ROLES_ALLOWED=
COGNITIVE_FIRM_KERNEL_TENANT_IDS=

# Browser-visible Orbit token. For local development, set this to the same
# value as ORBIT_API_TOKEN when the frontend should call write endpoints.
VITE_ORBIT_API_TOKEN=

# ─────────────────────────────────────────────────────────────────────
# 5. Filesystem state-backend overrides (advanced)
# ─────────────────────────────────────────────────────────────────────
# The kernel writes runtime state to fixed paths under the repo root.
# These overrides exist for tests and unusual deployments (e.g.
# shared-volume multi-tenant). Default values are computed from ORG_ROOT and
# COGNITIVE_FIRM_WORKSPACE at module load.

# Path to the org/ tree the kernel reads (roles, mandates, preferences).
# Default: <repo_root>/org
ORG_ROOT=

# Path to runtime workspace state. Default: <repo_root>/cognitive_firm_workspace
COGNITIVE_FIRM_WORKSPACE=

# Optional private tenant overlay root used by tenant-aware helper scripts.
TENANT_ROOT=

# Path to transitions.jsonl (the append-only event outbox).
# Default: <repo_root>/cognitive_firm_workspace/transitions.jsonl
TRANSITIONS_LOG=

# Path to the pending-gates queue.
# Default: <repo_root>/cognitive_firm_workspace/gates/pending
GATES_DIR=

# Path to the resolved-gates archive.
# Default: <repo_root>/cognitive_firm_workspace/gates/resolved
GATES_RESOLVED_DIR=

# Mutation backend used by the kernel service for lease records and guarded
# mutation events. "jsonl" preserves T1 filesystem lease files. "sqlite"
# enables transactional lease fencing on one host.
# Default: jsonl
COGNITIVE_FIRM_MUTATION_BACKEND=jsonl

# SQLite database path used when COGNITIVE_FIRM_MUTATION_BACKEND=sqlite.
# Default: <repo_root>/cognitive_firm_workspace/kernel_mutations.sqlite3
COGNITIVE_FIRM_MUTATION_DB=

# Optional live Linear MCP smoke. Never commit a filled value.
LINEAR_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# 6. Notification channel
# ─────────────────────────────────────────────────────────────────────
# Stable outbound notification facade. Telegram is the default provider for
# mobile/fast-layer alerts; null disables outbound push for local tests.
# Supported: telegram, null
COGNITIVE_FIRM_NOTIFICATION_CHANNEL=telegram

# Optional ntfy notification provider settings.
COGNITIVE_FIRM_NTFY_TOPIC=
NTFY_TOPIC=

# Optional HMAC key for audit-integrity manifests.
COGNITIVE_FIRM_AUDIT_HMAC_KEY=

# ─────────────────────────────────────────────────────────────────────
# 7. Daemon polling (advanced)
# ─────────────────────────────────────────────────────────────────────

# Daemon tick interval in seconds. Default: 60
POLL_SECONDS=60

# Long-poll timeout for Orbit chat-state polling, milliseconds.
# Default: 25000 (25s — under most browser/proxy 30s timeout)
LONG_POLL_TIMEOUT=25000

# ─────────────────────────────────────────────────────────────────────
# 8. Docker smoke test
# ─────────────────────────────────────────────────────────────────────

# Image tag used by scripts/docker_smoke.sh.
IMAGE=cognitive-firm-public-smoke

# ─────────────────────────────────────────────────────────────────────
# Notes
# ─────────────────────────────────────────────────────────────────────
# - .env is gitignored. Never commit a filled-in copy.
# - Production deployments should put secrets in a secrets manager
#   (systemd EnvironmentFile, AWS Secrets Manager, sops, etc.) rather
#   than a flat .env file.
# - Agent CLI subprocesses prefer subscription/local auth. Known provider API
#   env is stripped only for the selected CLI so subscription auth wins.
#   Substrate-side LLMRuntime API calls remain separate from agent CLI work.
