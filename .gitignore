# Python
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# Node
node_modules/
orbit/dist/

# OS
.DS_Store
*.log

# Internal notes — private threat models, competitive analysis, unshipped roadmap.
# Anything that would compromise positioning if public goes here.
internal/

# Local config (never commit)
.env
.env.local
*.env
org/mandates/.telegram_creds
org/mandates/.telegram_offset
org/sessions/inbound.jsonl

# Tenant overlays — these always live in separate private repos
tenants/*/
!tenants/EXAMPLE/
!tenants/README.md
!tenants/.gitkeep

# Runtime state generated by the daemon
ztare_workspace/
org/sessions/*/
!org/sessions/.gitkeep
org/signals/damage/*.json
!org/signals/damage/.gitkeep
org/objectives/
org/key_results/
org/tasks/active/
org/tasks/done/
org/directives/
