# Python
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# Node
node_modules/
orbit/dist/

# OS
.DS_Store
*.log

# Internal notes — private threat models, competitive analysis, unshipped roadmap.
# Anything that would compromise positioning if public goes here.
internal/

# Local review artifacts. Public docs define review record shapes; concrete
# panel outputs and adversarial review notes stay local unless intentionally
# promoted into docs.
reviews/

# Local config (never commit)
.env
.env.local
*.env
org/mandates/.telegram_creds
org/mandates/.telegram_offset
org/sessions/inbound.jsonl

# Tenant overlays — these always live in separate private repos
tenants/*/
!tenants/example/
!tenants/example/**
!tenants/README.md
!tenants/.gitkeep

# Local operator preferences copied from templates.
org/preferences/principal.yaml

# Runtime state generated by the daemon
cognitive_firm_workspace/
ztare_workspace/
org/sessions/*/
!org/sessions/.gitkeep
org/signals/damage/*.json
!org/signals/damage/.gitkeep
org/objectives/
org/key_results/
org/tasks/active/
org/tasks/done/
org/directives/

# Obsidian — per-user UI state (the vault config itself is tracked)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
