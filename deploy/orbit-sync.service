[Unit]
Description=Orbit Governance Backend (git-sync + WebSocket)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Replace `cognitive` with the unprivileged user that owns the checkout.
User=cognitive
WorkingDirectory=/home/cognitive/cognitive-firm/orbit
EnvironmentFile=-/home/cognitive/cognitive-firm/.env
ExecStart=/usr/bin/npm run sync
Restart=on-failure
RestartSec=30

# Bind 127.0.0.1 by default — no public exposure. Use SSH port-forward
# to access from your laptop:
#   ssh -L 3001:localhost:3001 cognitive@<vps-ip>
#   then http://localhost:3001 in your browser
Environment=ORBIT_BACKEND_HOST=127.0.0.1
Environment=ORBIT_BACKEND_PORT=3001

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=orbit-sync

[Install]
WantedBy=multi-user.target
