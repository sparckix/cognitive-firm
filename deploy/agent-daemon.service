[Unit]
Description=cognitive-firm Persistent Agent Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Replace `cognitive` with the unprivileged user that owns the checkout.
User=cognitive
WorkingDirectory=/home/cognitive/cognitive-firm
EnvironmentFile=-/home/cognitive/cognitive-firm/.env
ExecStart=/home/cognitive/cognitive-firm/venv/bin/python scripts/agent_daemon.py --interval 600
Restart=on-failure
RestartSec=60

# Safety limits
TimeoutStopSec=120
MemoryMax=2G
CPUQuota=50%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cognitive-firm-daemon

[Install]
WantedBy=multi-user.target
